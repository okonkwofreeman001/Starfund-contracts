# Build
/target/
target_local/
**/*.rs.bk
# Root Cargo.lock is intentionally tracked for reproducible builds.
.cargo/

# Local command outputs (generated)
build_output*.txt
test_output*.txt

# Local notes / PR scratch files
PR_DESCRIPTION.md
TODO.md

# Test snapshots (generated)
**/test_snapshots/
**/__snapshots__/
*.snap
*.snap.new

# Proptest regressions are intentionally tracked — see note at bottom.
# But generated case files from other fuzz tools are not.
*.proptest-regressions

node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Scratch / captured output (do not recreate at repo root)
*.exe
*.pdb
ci_logs*.txt
ci_main.txt
out.txt
test_out*.log
commit_msg.txt
ghit-*.md

# Coverage artifacts
lcov.info
tarpaulin-report.html
coverage/

# Temporary files
*.tmp
*.bak
*.orig

# Note: escrow/proptest-regressions/ is intentionally tracked — proptest
# regression seeds must be committed for reproducible CI runs.
